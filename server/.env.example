# OpenAI (optional). If set, chat uses OpenAI by default.
OPENAI_API_KEY=

# Hugging Face Inference (optional). If set and MODEL_BACKEND=hf, will use hf inference.
HUGGINGFACE_API_TOKEN=
MODEL_BACKEND=openai   # options: openai | hf | local
# If MODEL_BACKEND=local, set TGI_URL to your text-generation-inference endpoint (e.g. http://localhost:8080)
TGI_URL=

# Optional NewsAPI key (for news connector)
NEWSAPI_KEY=

# Server port
PORT=8000
